[Unit]
Description=Apply bernie GPU power caps
After=systemd-modules-load.service
ConditionPathExists="/etc/bernie/power.yaml"

[Service]
Type=oneshot
ExecStart="/usr/local/bin/bernie" tune power apply --file "/etc/bernie/power.yaml"
RemainAfterExit=no
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths="/etc/bernie/power.yaml"
ReadWritePaths=/sys/class/drm /sys/class/hwmon
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
