# Copy to .env. Compose reads it from this directory.

# Dashboard token. Required to log in; any non-loopback listen address needs it.
# Make one: openssl rand -hex 24
# Empty = bernie prints a random token in `docker compose logs`.
BERNIE_DASH_TOKEN=

# Image release tag. Pin a version, never latest (https://github.com/opengfx1030/bernie/releases).
BERNIE_TAG=v0.1.0

# Host address for port 7860. Keep 127.0.0.1 unless you want network access.
BERNIE_BIND=127.0.0.1

# Numeric group ids of the GPU devices on THIS host (names do not resolve in
# the image): stat -c %g /dev/kfd /dev/dri/renderD128
VIDEO_GID=44
RENDER_GID=105
